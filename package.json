{
  "name": "php-types",
  "displayName": "PHP Doc Extended",
  "description": "PHP Doc Extended with generics, templates, inheritance and more.",
  "icon": "res/icon.png",
  "version": "2.0.1",
  "publisher": "ErnstStavroBlofeld",
  "repository": {
    "url": "https://github.com/ErnstStavroBlofeld/php-types"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:php"
  ],
  "contributes": {
    "languages": [
      {
        "id": "phpdoc"
      }
    ],
    "grammars": [
      {
        "language": "phpdoc",
        "scopeName": "text.phpdoc",
        "injectTo": [
          "text.html.php"
        ],
        "path": "./syntaxes/php.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "dependencies": {
    "@rightcapital/phpdoc-parser": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.72.0",
    "typescript": "^5.0.0"
  }
}
